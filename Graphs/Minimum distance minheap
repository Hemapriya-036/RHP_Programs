#include<iostream>
#include<vector>
#include<set>
#include<queue>
#include<map>
using namespace std;
int main(){
	int R;
	cin>>R;
	map<int,vector<pair<int,int>>> g;
	while(R--){
		int src,dest,dist;
		cin>>src>>dest>>dist;
		g[src].push_back(make_pair(dest,dist));
		g[dest].push_back(make_pair(src,dist));
	}
	set<int> visited;
	int st,end;
	cin>>st>>end;
	priority_queue<pair<int,int>,vector<pair<int,int>>,greater<pair<int,int>>> pq;
	pq.push(make_pair(0,st));
	while(!pq.empty()){
		auto[currDist,city] = pq.top();
		pq.pop();
		if(city == end){
			cout<<currDist<<endl;
			return 0;
		}
		if(!visited.contains(city)){
			visited.insert(city);
		}
		for(auto[acd,ac]:g[city]){
			if(!visited.contains(ac)){
				pq.push(make_pair(acd+currDist,ac));
			}
		}
	}
}
