/*
Given a matrix, select exactly one element from each
column such that the same row is not chosen in two
consecutive columns. The program finds the maximum
possible sum using Dynamic Programming.
*/

#include <iostream>
using namespace std;

int main(){
    int R, C;
    cin >> R >> C;

    int arr[100][100];
    long long dp[100][100];

    for(int row = 0; row < R; row++){
        for(int col = 0; col < C; col++){
            cin >> arr[row][col];
            if(col == 0){
                dp[row][col] = arr[row][col];
            }
        }
    }

    for(int col = 1; col < C; col++){
        long long firstMax = max(dp[0][col - 1], dp[1][col - 1]);
        long long secondMax = min(dp[0][col - 1], dp[1][col - 1]);
        for(int row = 2; row < R; row++){
            if(dp[row][col - 1] > firstMax){
                secondMax = firstMax;
                firstMax = dp[row][col - 1];
            }
            else if(dp[row][col - 1] > secondMax){
                secondMax = dp[row][col - 1];
            }
        }

        for(int row = 0; row < R; row++){
            if(dp[row][col - 1] == firstMax){
                dp[row][col] = arr[row][col] + secondMax;
            {
            else{
                dp[row][col] = arr[row][col] + firstMax;
            {
        }
    }

    long long answer = dp[0][C - 1];
    for(int row = 1; row < R; row++){
        if(dp[row][C - 1] > answer)
            answer = dp[row][C - 1];
    }
    cout << answer;
    return 0;
}
